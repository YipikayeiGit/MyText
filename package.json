{
  "name": "mytext",
  "productName": "MyText",
  "version": "1.0.4",
  "description": "Editor de textos MyText",
  "author": "YipikayeiGit",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/YipikayeiGit/MyText.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "jszip": "3.10.1",
    "mammoth": "1.8.0",
    "pdfjs-dist": "3.11.174",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yipikayei.mytext",
    "productName": "MyText",
    "files": [
      "main.js",
      "preload.js",
      "editor/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyText",
      "artifactName": "MyText-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "MyText.docx",
        "description": "Documento de Word",
        "role": "Editor"
      },
      {
        "ext": [
          "doc",
          "dot"
        ],
        "name": "MyText.doc",
        "description": "Documento de Word 97-2003",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "MyText.pdf",
        "description": "Documento PDF",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "MyText.txt",
        "description": "Documento de texto",
        "role": "Editor"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "MyText.md",
        "description": "Documento Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "MyText.html",
        "description": "Página web",
        "role": "Editor"
      },
      {
        "ext": "rtf",
        "name": "MyText.rtf",
        "description": "Texto enriquecido",
        "role": "Editor"
      },
      {
        "ext": "odt",
        "name": "MyText.odt",
        "description": "Documento OpenDocument",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YipikayeiGit",
        "repo": "MyText",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
